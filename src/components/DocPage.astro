---
import { render } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';
import NotWritten from './NotWritten.astro';
import WallpaperBanner from './WallpaperBanner.astro';
import { docTitle, isStub, sourcePath, type DocEntry } from '../lib/docs';
import { docHref } from '../lib/doc-paths.mjs';

interface Props {
	entry: DocEntry;
}

const { entry } = Astro.props;
const title = docTitle(entry);
const stub = isStub(entry);
const rendered = stub ? null : await render(entry);
const isOverview = entry.id === 'readme';
const folders = sourcePath(entry).replace(/\.md$/i, '').split('/').slice(0, -1);
const pageHref = docHref(entry.id);
const sourceUrl = `https://github.com/WavesOS-Repos/wavesosdocs/blob/main/${sourcePath(entry)}`;
---

<DocsLayout title={title} currentHref={pageHref} headings={rendered?.headings ?? []} sourceUrl={sourceUrl}>
	{isOverview && <WallpaperBanner />}
	{
		!isOverview && (
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/">Overview</a>
				{folders.map((folder) => <span>/ {folder}</span>)}
			</nav>
		)
	}
	{rendered ? <rendered.Content /> : <NotWritten title={title} />}
</DocsLayout>
