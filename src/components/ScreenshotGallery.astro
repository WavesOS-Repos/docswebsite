---
interface Props {
	images: string[];
}

const { images } = Astro.props;
---

{
	images.length > 0 && (
		<section class="gallery-section">
			<h2>Screenshots</h2>
			<div class="gallery">
				{images.map((src, index) => (
					<a class="gallery-item" href={src} target="_blank" rel="noreferrer">
						<img src={src} alt={`WavesHyprland screenshot ${index + 1}`} loading="lazy" decoding="async" />
					</a>
				))}
			</div>
		</section>
	)
}
